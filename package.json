{
  "name": "genci-os-testlab",
  "version": "1.1.1",
  "description": "Genči OS TestLab – offline precvičovanie otázok zo systémových volaní (OS)",
  "main": "main.js",
  "author": "Dávid Babjarčík",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "sk.tuke.gencios.testlab",
    "productName": "Genci OS TestLab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
